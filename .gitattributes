# Normalize line endings: use LF in repository, auto-convert on checkout
* text=auto eol=lf

# Force LF for these file types
*.cs        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.sh        text eol=lf

# Binary files – no conversion
*.png       binary
*.jpg       binary
*.ico       binary
*.db        binary
